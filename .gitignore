# RIVF26 Git safety policy
#
# Keep source code, configs, tests, small manifests, summaries, and plot-ready
# data reviewable. Never allow a blanket `git add .` to capture raw benchmark
# output, model weights, caches, or profiler databases.

# High-volume run data (usually symlinks to RIVF26_BULK_ROOT). Excludes raw/'s
# *contents* (not the directory itself) so the negation below for
# per_request.csv can re-include it -- git cannot re-include a file whose
# parent directory is itself excluded, only a file excluded via a content
# wildcard.
results/**/raw/*
results/**/logs/
results/**/logs
logs/
profiler/
manifests/**/snapshots/

# Runtime logs, telemetry databases, profiler reports, and traces.
*.log
*.nsys-rep
*.qdstrm
*.sqlite
*.sqlite-journal
*.db
*.pt.trace.json
*.pt.trace.json.gz
*.kineto.json
*.jsonl
*.csv.gz
*.parquet

# Model weights, checkpoints, core dumps, and other large binaries.
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.core
core
core.*

# Dataset/model caches and temporary files.
.cache/
cache/
tmp/
*.tmp
*.temp
*.part
*.swp
*.swo
*~
__pycache__/
*.py[cod]

# Generated plot images/reports are reproducible from plot_data.json.
results/**/stacked_timeline.html
results/**/stacked_timeline.svg
results/**/stacked_timeline.png
results/**/comparison_*.html
results/**/comparison_*.svg
results/**/comparison_*.png

# Dataset files must not be copied into the repository.
datasets/processed/
datasets/cache/
datasets/**/*.csv
datasets/**/*.jsonl
datasets/**/*.parquet

# Preserve small, reproducibility-critical tracked artifacts.
!configs/*.csv
!tests/fixtures/*.csv
!tests/fixtures/*.jsonl
!traces/processed/*.csv
!datasets/metadata/*.json
!manifests/**/*.json
!manifests/**/*.txt
!results/**/manifest.json
!results/**/summary.json
!results/**/rouge_summary.json
!results/**/plot_data.json
!results/**/hbm_metadata.json
!results/**/raw/per_request.csv
!e2e_metrics_record.csv
